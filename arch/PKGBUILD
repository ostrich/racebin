# Maintainer: ostrich <570911+ostrich@users.noreply.github.com>
pkgname=racebin-git
pkgver=4.0.0.r41.gf750373
pkgrel=1
pkgdesc="API-first self-hosted paste bin with attachments"
arch=('x86_64' 'aarch64')
url="https://github.com/ostrich/racebin"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git' 'npm')
provides=('racebin')
conflicts=('racebin')
backup=('etc/racebin.conf')
options=(!lto)
source=("racebin::git+https://github.com/ostrich/racebin.git#branch=master")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/racebin"
    printf '%s.r%s.g%s' \
        "$(sed -n 's/^version = \"\([^\"]*\)\"/\1/p' Cargo.toml | head -n1)" \
        "$(git rev-list --count HEAD -- . ':(exclude)arch')" \
        "$(git log -1 --format=%h -- . ':(exclude)arch')"
}

build() {
    cd "$srcdir/racebin"
    npm --prefix web ci
    npm --prefix web run build
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --locked
}

package() {
    cd "$srcdir/racebin"
    install -Dm0755 target/release/racebin "$pkgdir/usr/bin/racebin"
    install -Dm0644 LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 THIRD_PARTY_RUST_LICENSES.html \
        "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_RUST_LICENSES.html"
    install -Dm0644 THIRD_PARTY_FRONTEND_LICENSES.md \
        "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_FRONTEND_LICENSES.md"
    install -Dm0644 packaging/racebin.service \
        "$pkgdir/usr/lib/systemd/system/racebin.service"
    install -Dm0644 packaging/racebin.conf.example "$pkgdir/etc/racebin.conf"
}
