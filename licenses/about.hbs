<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Racebin third-party Rust licenses</title>
  <style>
    body { font-family: sans-serif; line-height: 1.45; margin: 2rem auto; max-width: 70rem; padding: 0 1rem; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border-bottom: 1px solid #ccc; padding: .4rem; text-align: left; }
    pre { overflow: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>Racebin third-party Rust licenses</h1>
  <p>This document lists Rust crates incorporated into Racebin and their licenses.</p>
  <table>
    <thead><tr><th>Package</th><th>Version</th><th>License</th></tr></thead>
    <tbody>
    {{#each crates}}
      <tr>
        <td><a href="{{#if package.repository}}{{package.repository}}{{else}}https://crates.io/crates/{{package.name}}{{/if}}">{{package.name}}</a></td>
        <td>{{package.version}}</td>
        <td>{{license}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  <h2>License texts</h2>
  {{#each overview}}
    <h3 id="{{id}}">{{name}}</h3>
    <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
